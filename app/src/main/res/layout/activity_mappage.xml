<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.TenantMappage">

    <!-- MapView for OpenStreetMap -->
    <org.osmdroid.views.MapView
        android:id="@+id/osm_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Address Box at the Top -->
    <TextView
        android:id="@+id/address_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/whitebg"
        android:padding="10dp"
        android:text="Fetching address..."
        android:gravity="center_vertical"
        android:drawableEnd="@drawable/document2"
        android:textColor="@color/black"
        android:layout_alignParentTop="true" />

    <!-- Scan Area Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/scan_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="100dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/blue_bg"
        android:padding="10dp"
        android:text="Scan Area"
        android:textColor="@color/white" />
</RelativeLayout>
