<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".fragments.OwnerPostpage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        android:padding="20dp"
        android:paddingBottom="100dp"> <!-- Add bottom padding to allow for scrolling space -->

        <!-- Header with Image aligned to the right -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/text_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add new"
                    android:textSize="24sp"
                    android:textColor="@color/black"
                    android:paddingBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listing"
                    android:textSize="35sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Boarding House"
                    android:textSize="24sp"
                    android:textColor="@color/black"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_margin="8dp"
                android:src="@drawable/box"
                android:contentDescription="Add image" />
        </RelativeLayout>

        <!-- Image Upload Section -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/white"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/postpic" />
        </FrameLayout>

        <!-- Listing Information Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listing Information"
            android:textSize="25sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/board_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title/Bed Spacers/Appartment"
            android:background="@drawable/whitebg"
            android:padding="15dp"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/board_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Price"
                android:background="@drawable/whitebg"
                android:padding="15dp"
                android:inputType="numberDecimal" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:padding="8dp">

                <Spinner
                    android:id="@+id/board_paymentOptions"
                    android:layout_width="180dp"
                    android:layout_height="48dp"
                    android:entries="@array/payment_options"
                    android:backgroundTint="#000000"
                    android:layout_gravity="center"/>
            </FrameLayout>

        </LinearLayout>

        <Spinner
            android:id="@+id/board_selectionOptions"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:entries="@array/selection_options"
            android:backgroundTint="@color/black"
            android:layout_marginBottom="10dp"
            android:spinnerMode="dropdown" />


        <org.osmdroid.views.MapView
            android:id="@+id/osm_map_view"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="10dp" />


        <EditText
            android:id="@+id/board_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Address"
            android:background="@drawable/whitebg"
            android:padding="15dp"
            android:inputType="textPostalAddress"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/board_description"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Description"
            android:background="@drawable/whitebg"
            android:padding="15dp"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/board_otherDetails"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Other Details"
            android:background="@drawable/whitebg"
            android:padding="15dp"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:layout_marginBottom="180dp" />

        <!-- Create Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/postBoardingHouseBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create"
            android:minHeight="48dp"
            android:padding="16dp"
            android:background="@drawable/blue_bg"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="70dp" /> <!-- Add margin to ensure it's visible -->

    </LinearLayout>
</ScrollView>
